# Copy to .env for local use, or add each variable in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Never prefix server secrets with VITE_ (those are shipped to the browser).

# --- Required (cloud / Vercel deployment) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
VITE_APP_ID=

# --- Needed only for provisioning scripts / integration tests ---
SUPABASE_ACCESS_TOKEN=
INITIAL_ADMIN_PASSWORD=

# --- Optional: official PDF header storage proxy ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
